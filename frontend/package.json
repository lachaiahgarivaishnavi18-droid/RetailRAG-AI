{
  "name": "context-cart-vercel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": "24.x" },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": { "next": "16.4.5", "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "^24.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0" }
}
