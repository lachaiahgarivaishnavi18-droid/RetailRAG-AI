# Server-side only. Production must use the separately hosted HTTPS backend.
BACKEND_API_URL=http://127.0.0.1:8000
# Optional HTTPS URL of the retained Streamlit application.
STREAMLIT_APP_URL=
# Recommendation/agent requests save records. Enable only behind access controls.
ENABLE_SAVED_GENERATION=false
# No OPENAI_API_KEY, database URL, or Chroma files belong in this frontend.
