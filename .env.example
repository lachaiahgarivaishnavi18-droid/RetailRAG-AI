RETAILRAG_APP_NAME=RetailRAG AI
RETAILRAG_ENVIRONMENT=development
RETAILRAG_API_BASE_URL=http://127.0.0.1:8000
RETAILRAG_DATABASE_URL=sqlite:///./data/retailrag.db
RETAILRAG_RAG_DIRECTORY=data/chroma
RETAILRAG_RAG_COLLECTION=retailrag_products
RETAILRAG_RAG_CHUNK_SIZE=1000
# Copy to .env only if you want to customize defaults. No .env is required.
# auto uses OpenAI only when a nonempty key is available; failures fall back locally.
# Set DEMO_MODE=true to guarantee no external AI calls even with a saved key.
DEMO_MODE=auto
RETAILRAG_RAG_GENERATION_MODE=auto
RETAILRAG_RAG_OPENAI_MODEL=gpt-4.1-mini
RETAILRAG_RAG_LLM_TIMEOUT=15
# Optional; no credentials are required for the local RAG fallback.
OPENAI_API_KEY=
# Optional local document storage; no PostgreSQL or cloud credentials required.
RETAILRAG_DOCUMENT_DATABASE=data/local_documents.db
# RETAILRAG_MIGRATION_DATABASE_URL is a deployment-only setting, NOT needed here.
